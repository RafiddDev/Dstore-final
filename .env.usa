APP_NAME="D-STORE Node: USA"
APP_ENV=usa
APP_KEY=base64:XdIIGku+e71r9b8CsVllJLdsV2hhNPokBVXZskIrICs=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# D-STORE runs with ZERO database systems.
# DB_CONNECTION=null ensures no database driver can ever be resolved.
# Framework cache/session/queue use the filesystem.
DB_CONNECTION=null
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dstore@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------- D-STORE: node identity ----------
DSTORE_NODE_ID=usa
DSTORE_NODE_NAME=USA
DSTORE_REGION=north-america
DSTORE_PUBLIC_URL=http://127.0.0.1:8003
DSTORE_PORT=8003
DSTORE_STORAGE_PATH=nodes/usa/storage/dstore

# ---------- D-STORE: peers ----------
DSTORE_PEERS=pakistan,uae,uk
DSTORE_PEER_PAKISTAN_URL=http://127.0.0.1:8001
DSTORE_PEER_UAE_URL=http://127.0.0.1:8002
DSTORE_PEER_UK_URL=http://127.0.0.1:8004

# ---------- D-STORE: security ----------
DSTORE_BOOTSTRAP_TOKEN=f9a8b7137e5f9d82014f862d869b355099f53108401087318b7065cbc7930d3e
DSTORE_REGISTRATION_MODE=token

# ---------- D-STORE: monitoring ----------
DSTORE_HEARTBEAT_INTERVAL=5
DSTORE_HEARTBEAT_TIMEOUT=15
DSTORE_MISSES_BEFORE_OFFLINE=3

# ---------- D-STORE: replication ----------
DSTORE_RETRY_BASE_DELAY=2
DSTORE_RETRY_MAX_DELAY=300
DSTORE_EVENT_MAX_ATTEMPTS=10
DSTORE_REPLAY_WINDOW=300
DSTORE_MAX_CLOCK_SKEW=300
DSTORE_REQUIRE_SIGNED_EVENTS=true
DSTORE_PUSH_BATCH_SIZE=100

# ---------- D-STORE: consistency ----------
DSTORE_CONFLICT_POLICY=merge
DSTORE_TOMBSTONE_GC_DAYS=7
