APP_NAME="D-STORE Node"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# D-STORE runs with ZERO database systems — DB_CONNECTION=null ensures no
# database driver can ever be resolved. Cache/session/queue use the filesystem.
DB_CONNECTION=null
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="dstore@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------- D-STORE: node identity (copy this template per node) ----------
DSTORE_NODE_ID=node1
DSTORE_NODE_NAME="Node 1"
DSTORE_REGION=local
DSTORE_PUBLIC_URL=http://127.0.0.1:8001
DSTORE_PORT=8001
DSTORE_STORAGE_PATH=nodes/node1/storage/dstore

# ---------- D-STORE: peers ----------
DSTORE_PEERS=
# DSTORE_PEER_<NODE>_URL=http://127.0.0.1:8002

# ---------- D-STORE: security ----------
DSTORE_BOOTSTRAP_TOKEN=
DSTORE_REGISTRATION_MODE=token

# ---------- D-STORE: monitoring ----------
DSTORE_HEARTBEAT_INTERVAL=5
DSTORE_HEARTBEAT_TIMEOUT=15
DSTORE_MISSES_BEFORE_OFFLINE=3

# ---------- D-STORE: replication ----------
DSTORE_RETRY_BASE_DELAY=2
DSTORE_RETRY_MAX_DELAY=300
DSTORE_EVENT_MAX_ATTEMPTS=10
DSTORE_REPLAY_WINDOW=300
DSTORE_MAX_CLOCK_SKEW=300
DSTORE_REQUIRE_SIGNED_EVENTS=true
DSTORE_PUSH_BATCH_SIZE=100

# ---------- D-STORE: consistency ----------
DSTORE_CONFLICT_POLICY=vector-lww
DSTORE_TOMBSTONE_GC_DAYS=7
