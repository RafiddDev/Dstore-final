APP_NAME="D-STORE Test"
APP_ENV=testing
APP_KEY=base64:oqX1lJrRjiqqbBh+l+rE/XkmxQh39G++RTUg+hRt0ps=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# D-STORE runs with ZERO database systems.
DB_CONNECTION=null
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

DSTORE_NODE_ID=test-node
DSTORE_NODE_NAME="Test Node"
DSTORE_REGION=local
DSTORE_PUBLIC_URL=http://127.0.0.1:8000
DSTORE_PORT=8000
DSTORE_STORAGE_PATH=storage/framework/testing/dstore

DSTORE_PEERS=
DSTORE_BOOTSTRAP_TOKEN=test-bootstrap-token
DSTORE_REGISTRATION_MODE=token

DSTORE_HEARTBEAT_INTERVAL=5
DSTORE_HEARTBEAT_TIMEOUT=15
DSTORE_MISSES_BEFORE_OFFLINE=3

DSTORE_RETRY_BASE_DELAY=2
DSTORE_RETRY_MAX_DELAY=300
DSTORE_EVENT_MAX_ATTEMPTS=10
DSTORE_REPLAY_WINDOW=300
DSTORE_MAX_CLOCK_SKEW=300
DSTORE_REQUIRE_SIGNED_EVENTS=true
DSTORE_PUSH_BATCH_SIZE=100

DSTORE_CONFLICT_POLICY=vector-lww
DSTORE_TOMBSTONE_GC_DAYS=7
